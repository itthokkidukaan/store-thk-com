        LEFT JOIN (
            SELECT 
                pr.warehouse,
                COUNT(pr.id) AS pc,
                SUM(pr.product_price * IFNULL(pl.balance, 0)) AS salessum,
                SUM(pr.purchase_price * IFNULL(pl.balance, 0)) AS worthsum,
                SUM(IFNULL(pl.balance, 0)) AS qty
            FROM 
